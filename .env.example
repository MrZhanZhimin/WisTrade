# WisTrade Environment Variables Template
# Copy this file to .env and fill in your values

# =============================================================================
# AI Service Configuration
# =============================================================================

# Zhipu AI (GLM-4.7) API Key
# Get your API key from: https://open.bigmodel.cn/
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# OpenAI API Key (alternative AI provider)
# OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# Market Data Providers
# =============================================================================

# Tushare API Token
# Get your token from: https://tushare.pro/
TUSHARE_TOKEN=your_tushare_token_here

# =============================================================================
# Broker API Configuration
# =============================================================================

# Note: Broker credentials are stored encrypted in the database
# These environment variables are for initial setup only

# Default broker (zhao_shang | guang_da | jiang_hai)
DEFAULT_BROKER=zhao_shang

# QMT Client Path (optional - auto-detect if not set)
# QMT_PATH=/path/to/qmt/client

# =============================================================================
# Database Configuration
# =============================================================================

# Database encryption password (REQUIRED for production)
# This password protects your API keys and account credentials
# Use a strong password with at least 32 characters
DB_ENCRYPTION_KEY=change_this_to_a_strong_password

# =============================================================================
# Application Settings
# =============================================================================

# Environment (development | staging | production)
APP_ENV=development

# Log level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Debug mode (true | false)
DEBUG=true

# =============================================================================
# Security Settings
# =============================================================================

# Secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_a_random_secret_key_here

# =============================================================================
# Optional: Monitoring & Analytics
# =============================================================================

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# Prometheus metrics port (optional)
# METRICS_PORT=9090
